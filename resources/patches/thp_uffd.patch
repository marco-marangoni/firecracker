Subject: [PATCH] POC: use PMD when userfaultd returns a 2MiB memory range
---
Index: mm/userfaultfd.c
IDEA additional info:
Subsystem: com.intellij.openapi.diff.impl.patch.CharsetEP
<+>UTF-8
===================================================================
diff --git a/mm/userfaultfd.c b/mm/userfaultfd.c
--- a/mm/userfaultfd.c	(revision 502d801f0ab03e4f32f9a33d203154ce84887921)
+++ b/mm/userfaultfd.c	(revision 6b959e43a2cee0cd08c2de438ffc7fe61afab327)
@@ -34,6 +34,9 @@
 #include <linux/cleanup.h>
 #include <asm/tlbflush.h>
 #include <asm/tlb.h>
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+#include <asm/pgalloc.h>
+#endif
 #include "internal.h"
 #include "swap.h"
 
@@ -48,6 +51,8 @@
 	unsigned long src_addr;
 	unsigned long dst_addr;
 	pmd_t *pmd;
+	unsigned long page_size; /* size of folio installed in last iteration */
+	int alloc_order;	 /* desired folio order derived from request */
 };
 
 static bool anon_can_userfault(struct vm_area_struct *vma, vm_flags_t vm_flags)
@@ -426,6 +431,67 @@
 out:
 	return ret;
 }
+
+/*
+ * Install a PMD-level huge page mapping for a THP folio resolved via
+ * UFFDIO_COPY.  The PMD must be empty.
+ */
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+static int mfill_atomic_install_pmd(pmd_t *dst_pmd,
+				    struct vm_area_struct *dst_vma,
+				    unsigned long dst_addr,
+				    struct folio *folio,
+				    uffd_flags_t flags)
+{
+	struct mm_struct *dst_mm = dst_vma->vm_mm;
+	spinlock_t *ptl;
+	pmd_t entry;
+	pgtable_t pgtable;
+	int ret = -ENOMEM;
+
+	VM_BUG_ON(dst_addr & ~HPAGE_PMD_MASK);
+
+	pgtable = pte_alloc_one(dst_mm);
+	if (!pgtable)
+		goto out;
+
+	entry = folio_mk_pmd(folio, dst_vma->vm_page_prot);
+	entry = pmd_mkdirty(entry);
+	if (dst_vma->vm_flags & VM_WRITE)
+		entry = maybe_pmd_mkwrite(entry, dst_vma);
+	if (flags & MFILL_ATOMIC_WP)
+		entry = pmd_mkuffd_wp(entry);
+
+	ptl = pmd_lock(dst_mm, dst_pmd);
+
+	ret = -EEXIST;
+	if (!pmd_none(*dst_pmd))
+		goto out_unlock;
+
+	folio_add_new_anon_rmap(folio, dst_vma, dst_addr, RMAP_EXCLUSIVE);
+	folio_add_lru_vma(folio, dst_vma);
+	pgtable_trans_huge_deposit(dst_mm, dst_pmd, pgtable);
+
+	set_pmd_at(dst_mm, dst_addr, dst_pmd, entry);
+	update_mmu_cache_pmd(dst_vma, dst_addr, dst_pmd);
+
+	add_mm_counter(dst_mm, MM_ANONPAGES, HPAGE_PMD_NR);
+	mm_inc_nr_ptes(dst_mm);
+	count_vm_event(THP_FAULT_ALLOC);
+	count_mthp_stat(HPAGE_PMD_ORDER, MTHP_STAT_ANON_FAULT_ALLOC);
+	count_memcg_event_mm(dst_mm, THP_FAULT_ALLOC);
+	deferred_split_folio(folio, false);
+
+	spin_unlock(ptl);
+	return 0;
+
+out_unlock:
+	spin_unlock(ptl);
+	pte_free(dst_mm, pgtable);
+out:
+	return ret;
+}
+#endif /* CONFIG_TRANSPARENT_HUGEPAGE */
 
 static int mfill_copy_folio_locked(struct folio *folio, unsigned long src_addr)
 {
@@ -450,7 +516,7 @@
 	 */
 	pagefault_disable();
 	ret = copy_from_user(kaddr, (const void __user *) src_addr,
-			     PAGE_SIZE);
+			     folio_size(folio));
 	pagefault_enable();
 	kunmap_local(kaddr);
 
@@ -537,7 +603,8 @@
 	mfill_put_vma(mfill_state);
 
 	kaddr = kmap_local_folio(folio, 0);
-	err = copy_from_user(kaddr, (const void __user *) src_addr, PAGE_SIZE);
+	err = copy_from_user(kaddr, (const void __user *) src_addr,
+			     folio_size(folio));
 	kunmap_local(kaddr);
 	if (unlikely(err))
 		return -EFAULT;
@@ -552,9 +619,23 @@
 	if (mfill_retry_state_changed(&retry_state, mfill_state->vma))
 		return -EAGAIN;
 
-	err = mfill_establish_pmd(mfill_state);
-	if (err)
-		return err;
+	/*
+	 * For THP folios we must NOT call mfill_establish_pmd() because
+	 * that allocates a page table under the PMD, which would prevent
+	 * installing the PMD-level huge page mapping.  Just re-walk to
+	 * get the PMD pointer.
+	 */
+	if (folio_order(folio) > 0) {
+		pmd_t *pmd = mm_alloc_pmd(mfill_state->ctx->mm,
+					  mfill_state->dst_addr);
+		if (!pmd)
+			return -ENOMEM;
+		mfill_state->pmd = pmd;
+	} else {
+		err = mfill_establish_pmd(mfill_state);
+		if (err)
+			return err;
+	}
 
 	return 0;
 }
@@ -573,9 +654,40 @@
 		return -EOPNOTSUPP;
 	}
 
-	folio = ops->alloc_folio(state->vma, state->dst_addr);
-	if (!folio)
-		return -ENOMEM;
+	/*
+	 * When userspace requests a large page resolution (alloc_order > 0),
+	 * allocate at the requested order directly rather than going through
+	 * ops->alloc_folio which only allocates order-0.
+	 */
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+	if (state->alloc_order > 0 && vma_is_anonymous(state->vma)) {
+		gfp_t gfp = vma_thp_gfp_mask(state->vma);
+
+		VM_BUG_ON(dst_addr & ((PAGE_SIZE << state->alloc_order) - 1));
+
+		folio = vma_alloc_folio(gfp, state->alloc_order, state->vma,
+				       dst_addr);
+		if (!folio) {
+			/* Fall back to order-0 */
+			goto fallback_alloc;
+		}
+		if (mem_cgroup_charge(folio, state->vma->vm_mm, gfp)) {
+			folio_put(folio);
+			goto fallback_alloc;
+		}
+		if (folio_memcg_alloc_deferred(folio)) {
+			folio_put(folio);
+			goto fallback_alloc;
+		}
+		folio_throttle_swaprate(folio, gfp);
+	} else
+#endif
+	{
+fallback_alloc:
+		folio = ops->alloc_folio(state->vma, dst_addr);
+		if (!folio)
+			return -ENOMEM;
+	}
 
 	if (uffd_flags_mode_is(flags, MFILL_ATOMIC_COPY)) {
 		ret = mfill_copy_folio_locked(folio, src_addr);
@@ -592,7 +704,12 @@
 				goto err_folio_put;
 		}
 	} else if (uffd_flags_mode_is(flags, MFILL_ATOMIC_ZEROPAGE)) {
-		clear_user_highpage(&folio->page, state->dst_addr);
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+		if (folio_order(folio) > 0)
+			folio_zero_user(folio, dst_addr);
+		else
+#endif
+			clear_user_highpage(&folio->page, dst_addr);
 	} else {
 		VM_WARN_ONCE(1, "Unknown UFFDIO operation, flags: %x", flags);
 	}
@@ -610,11 +727,36 @@
 			goto err_folio_put;
 	}
 
-	ret = mfill_atomic_install_pte(state->pmd, state->vma, dst_addr,
-				       &folio->page, flags);
+	if (folio_order(folio) > 0) {
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+		ret = mfill_atomic_install_pmd(state->pmd, state->vma,
+					       dst_addr, folio, flags);
+#else
+		ret = -EOPNOTSUPP;
+#endif
+	} else {
+		/*
+		 * If we fell back from a THP attempt, the page table may
+		 * not have been established (the outer loop skipped it for
+		 * PMD-order).  Ensure it exists before installing the PTE.
+		 */
+		if (state->alloc_order > 0) {
+			pmd_t pmdval = pmdp_get_lockless(state->pmd);
+
+			if (unlikely(pmd_none(pmdval)) &&
+			    unlikely(__pte_alloc(state->vma->vm_mm,
+						state->pmd)))  {
+				ret = -ENOMEM;
+				goto err_filemap_remove;
+			}
+		}
+		ret = mfill_atomic_install_pte(state->pmd, state->vma,
+					       dst_addr, &folio->page, flags);
+	}
 	if (ret)
 		goto err_filemap_remove;
 
+	state->page_size = folio_size(folio);
 	return 0;
 
 err_filemap_remove:
@@ -976,6 +1118,9 @@
 	};
 	long copied = 0;
 	ssize_t err;
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+	bool skip_thp = false;
+#endif
 
 	/*
 	 * Sanitize the command parameters:
@@ -1001,26 +1146,84 @@
 	while (state.src_addr < src_start + len) {
 		VM_WARN_ON_ONCE(state.dst_addr >= dst_start + len);
 
-		err = mfill_establish_pmd(&state);
-		if (err)
-			break;
+		/*
+		 * Determine the folio order for this iteration.  When the
+		 * addresses are PMD-aligned with enough remaining length,
+		 * attempt a PMD-sized allocation so userspace can resolve
+		 * faults at THP granularity via UFFDIO_COPY.
+		 */
+		state.alloc_order = 0;
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+		{
+		unsigned long remaining = src_start + len - state.src_addr;
+
+		if (!skip_thp &&
+		    vma_is_anonymous(state.vma) &&
+		    remaining >= HPAGE_PMD_SIZE &&
+		    IS_ALIGNED(state.dst_addr, HPAGE_PMD_SIZE) &&
+		    thp_vma_allowable_order(state.vma, state.vma->vm_flags,
+					   TVA_PAGEFAULT, PMD_ORDER))
+			state.alloc_order = PMD_ORDER;
+		}
+#endif
+
+		/*
+		 * For PMD-order THP, we only need the PMD pointer (not a
+		 * page table underneath it).  For regular pages, establish
+		 * the page table as usual.
+		 */
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+		if (state.alloc_order == PMD_ORDER) {
+			pmd_t *pmd = mm_alloc_pmd(ctx->mm, state.dst_addr);
+
+			if (!pmd) {
+				err = -ENOMEM;
+				break;
+			}
+			state.pmd = pmd;
+		} else
+#endif
+		{
+			err = mfill_establish_pmd(&state);
+			if (err)
+				break;
+		}
 
 		/*
 		 * For shmem mappings, khugepaged is allowed to remove page
 		 * tables under us; pte_offset_map_lock() will deal with that.
 		 */
 
+		state.page_size = PAGE_SIZE;
 		err = mfill_atomic_pte(&state);
 		cond_resched();
 
 		if (!err) {
-			state.dst_addr += PAGE_SIZE;
-			state.src_addr += PAGE_SIZE;
-			copied += PAGE_SIZE;
+			state.dst_addr += state.page_size;
+			state.src_addr += state.page_size;
+			copied += state.page_size;
+
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+			/* Clear skip_thp once we advance past the failed PMD */
+			if (skip_thp &&
+			    IS_ALIGNED(state.dst_addr, HPAGE_PMD_SIZE))
+				skip_thp = false;
+#endif
 
 			if (fatal_signal_pending(current))
 				err = -EINTR;
 		}
+#ifdef CONFIG_TRANSPARENT_HUGEPAGE
+		/*
+		 * If THP install raced and the PMD is no longer empty,
+		 * fall back to small pages for this address.
+		 */
+		if (err == -EEXIST && state.alloc_order > 0) {
+			skip_thp = true;
+			err = 0;
+			continue;
+		}
+#endif
 		if (err)
 			break;
 	}

