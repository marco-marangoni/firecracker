diff --git a/arch/x86/kvm/mmu/tdp_mmu.c b/arch/x86/kvm/mmu/tdp_mmu.c
--- a/arch/x86/kvm/mmu/tdp_mmu.c	(revision 502d801f0ab03e4f32f9a33d203154ce84887921)
+++ b/arch/x86/kvm/mmu/tdp_mmu.c	(revision 2eb6dd80cc3699bfeecfa68a0dc28f82f54e927a)
@@ -1209,6 +1209,90 @@
 static int tdp_mmu_split_huge_page(struct kvm *kvm, struct tdp_iter *iter,
 				   struct kvm_mmu_page *sp, bool shared);

+/*
+ * Prefetch adjacent SPTEs after handling a TDP page fault.  Scans empty SPTEs
+ * in the same page table around the faulting entry and, for each one whose
+ * host page is already present (non-blocking GUP), atomically installs an EPT
+ * mapping.  This eliminates future VM-exits for pages that were populated in
+ * the host (e.g. via a large UFFDIO_COPY) but not yet mapped in EPT.
+ */
+static void tdp_mmu_pte_prefetch(struct kvm_vcpu *vcpu,
+				 struct kvm_page_fault *fault,
+				 struct tdp_iter *iter)
+{
+	struct kvm_mmu_page *sp = sptep_to_sp(rcu_dereference(iter->sptep));
+	struct kvm_memory_slot *slot = fault->slot;
+	struct page *pages[PTE_PREFETCH_NUM];
+	unsigned int access = sp->role.access;
+	int start_idx, i;
+	gfn_t start_gfn;
+	int nr_pages;
+	u64 *sptep;
+
+	if (sp_ad_disabled(sp))
+		return;
+
+	if (unlikely(vcpu->kvm->mmu_invalidate_in_progress))
+		return;
+
+	/*
+	 * Determine the prefetch window: PTE_PREFETCH_NUM entries aligned
+	 * around the faulting SPTE within the same page table.
+	 */
+	start_idx = spte_index(rcu_dereference(iter->sptep)) &
+		    ~(PTE_PREFETCH_NUM - 1);
+
+	/* For direct (TDP) level-1 SPs: gfn = sp->gfn + index */
+	start_gfn = sp->gfn + start_idx;
+
+	/*
+	 * Non-blocking GUP: only resolves pages already present in host
+	 * page tables.  Returns 0 if none are available.
+	 */
+	nr_pages = kvm_prefetch_pages(slot, start_gfn, pages, PTE_PREFETCH_NUM);
+	if (nr_pages <= 0)
+		return;
+
+	vcpu->stat.pf_prefetch_called++;
+	vcpu->stat.pf_prefetch_pages += nr_pages;
+
+	sptep = sp->spt + start_idx;
+	for (i = 0; i < nr_pages; i++, sptep++) {
+		u64 old_spte = READ_ONCE(*sptep);
+		gfn_t gfn = start_gfn + i;
+		u64 new_spte;
+
+		/* Skip entries that are already present or the faulting entry. */
+		if (is_shadow_present_pte(old_spte) ||
+		    sptep == rcu_dereference(iter->sptep)) {
+			kvm_release_page_dirty(pages[i]);
+			continue;
+		}
+
+		/* Skip entries that aren't the standard non-present value. */
+		if (old_spte != SHADOW_NONPRESENT_VALUE) {
+			kvm_release_page_dirty(pages[i]);
+			continue;
+		}
+
+		make_spte(vcpu, sp, slot, access, gfn, page_to_pfn(pages[i]),
+			  old_spte, true /* prefetch */, false, true, &new_spte);
+
+		/*
+		 * Atomically install the SPTE only if it's still empty.
+		 * If another thread raced us, just move on.
+		 */
+		if (try_cmpxchg64(sptep, &old_spte, new_spte)) {
+			handle_changed_spte(vcpu->kvm, sp, gfn,
+					    SHADOW_NONPRESENT_VALUE, new_spte,
+					    PG_LEVEL_4K, true);
+			vcpu->stat.pf_prefetch_mapped++;
+		}
+
+		kvm_release_page_dirty(pages[i]);
+	}
+}
+
 /*
  * Handle a TDP page fault (NPT/EPT violation/misconfiguration) by installing
  * page tables and SPTEs to translate the faulting guest physical address.
@@ -1297,6 +1381,10 @@
 map_target_level:
 	ret = tdp_mmu_map_handle_target_level(vcpu, fault, &iter);

+	if (ret == RET_PF_FIXED && fault->goal_level == PG_LEVEL_4K &&
+	    !fault->prefetch && fault->slot)
+		tdp_mmu_pte_prefetch(vcpu, fault, &iter);
+
 retry:
 	rcu_read_unlock();
 	return ret;
