@@ -6783,6 +6786,17 @@
 {
 	int ret;
 
+	/*
+	 * Scratch space for fault-time prefetch: one page holds
+	 * SPTE_ENT_PER_PAGE (512) struct page pointers on 64-bit.  Freed in
+	 * mmu_free_memory_caches() via kvm_mmu_destroy().
+	 */
+	BUILD_BUG_ON(SPTE_ENT_PER_PAGE * sizeof(struct page *) > PAGE_SIZE);
+	vcpu->arch.mmu_prefetch_pages =
+		(struct page **)__get_free_page(GFP_KERNEL_ACCOUNT);
+	if (!vcpu->arch.mmu_prefetch_pages)
+		return -ENOMEM;
+
 	vcpu->arch.mmu_pte_list_desc_cache.kmem_cache = pte_list_desc_cache;
 	vcpu->arch.mmu_pte_list_desc_cache.gfp_zero = __GFP_ZERO;
 
