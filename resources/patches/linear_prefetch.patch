diff --git a/arch/x86/include/asm/kvm_host.h b/arch/x86/include/asm/kvm_host.h
--- a/arch/x86/include/asm/kvm_host.h	(revision 502d801f0ab03e4f32f9a33d203154ce84887921)
+++ b/arch/x86/include/asm/kvm_host.h	(revision 9124c27ccdd54def167ee5b1e47e45ee11f24477)
@@ -897,6 +897,19 @@
 	 */
 	struct kvm_mmu_memory_cache mmu_external_spt_cache;
 
+	/*
+	 * Scratch array of SPTE_ENT_PER_PAGE (512) page pointers used to hold
+	 * the result of a single wide GUP during TDP fault-time prefetch.  One
+	 * page, allocated per-vCPU in kvm_mmu_create().
+	 *
+	 * Lock-free: accessed only by the owning vCPU thread from the fault
+	 * path (kvm_tdp_mmu_map()), which never runs concurrently with itself
+	 * (serialized by vcpu->mutex / the loaded-vCPU model) and is
+	 * non-reentrant and non-sleeping while the array is live.  Must not be
+	 * used from any non-vCPU context (e.g. zap/mmu-notifier workers).
+	 */
+	struct page **mmu_prefetch_pages;
+
 	/*
 	 * QEMU userspace and the guest each have their own FPU state.
 	 * In vcpu_run, we switch between the user and guest FPU contexts.
@@ -1722,6 +1735,10 @@
 	u64 pf_fast;
 	u64 pf_mmio_spte_created;
 	u64 pf_guest;
+	u64 pf_prefetch_called;
+	u64 pf_prefetch_pages;
+	u64 pf_prefetch_mapped;
+	u64 pf_prefetch_unused;
